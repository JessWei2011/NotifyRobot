# 請複製此檔案為 .env 並填入你的 Telegram Bot 資訊
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Discord 一般台股通知頻道 Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Discord 主機心跳專用頻道 Webhook（建議建立另一個頻道）
DISCORD_HEARTBEAT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# 已驗證可用的 Shioaji 憑證檔位置；請勿將金鑰直接填入本檔或提交至 Git。
# SJ_ENV_FILE=/absolute/path/to/API test/.env
