# 請複製此檔案為 .env 並填入你的 Telegram / Discord 機器人資訊
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Discord 機器人設定（支援雙頻道分流）
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_general_stock_channel_id_here     # 台股通知頻道（自選股、重大訊息、行事曆、大盤法人金額）
DISCORD_CHIP_CHANNEL_ID=your_chip_channel_id_here         # 籌碼資料頻道（三大法人買賣超榜單、波段連續買超）

# 舊版/備用：Discord Webhook（若未設定 Bot Token 則會回退使用 Webhook）
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_HEARTBEAT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 已驗證可用的 Shioaji 憑證檔位置；請勿將金鑰直接填入本檔或提交至 Git。
# SJ_ENV_FILE=/absolute/path/to/API test/.env

# AI 新聞分析（可選：支援 Google Gemini API 進行個股新聞深度總結，免費申請）
# GEMINI_API_KEY=your_gemini_api_key_here
